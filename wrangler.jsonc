{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-appf",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "bf908bef-3d9c-4082-9755-48b9f38ec7a1","database_name": "web-appf" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "1ef816852b22467893a19e0e056d76b4" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
